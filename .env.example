ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Phoenix Cloud (enables tracing + eval annotations in Arize Phoenix Cloud)
# PHOENIX_API_KEY=your-phoenix-api-key

# Optional: set to any value to disable Phoenix tracing entirely
# DISABLE_PHOENIX=1

# Optional: frontend URL for CORS (set to your Vercel domain in production)
# FRONTEND_URL=https://your-app.vercel.app
